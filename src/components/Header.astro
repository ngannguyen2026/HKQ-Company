---
import { company } from "../data/site";

const links = [
  { href: "#gioi-thieu", label: "Giới thiệu" },
  { href: "#nang-luc", label: "Năng lực" },
  { href: "#san-pham", label: "Sản phẩm" },
  { href: "#gia-tri", label: "Giá trị" },
];
---

<header class="header" data-header>
  <div class="container inner">
    <a href="#top" class="logo" aria-label={`${company.name} — Trang chủ`} data-hover>
      <span class="logo-mark">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="none" stroke="url(#lg)" stroke-width="2"></circle>
          <path d="M16 1a15 15 0 0 1 0 30a7.5 7.5 0 0 1 0-15a7.5 7.5 0 0 0 0-15z" fill="url(#lg)"></path>
          <defs>
            <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#3ee0bd"></stop>
              <stop offset=".5" stop-color="#e8b45a"></stop>
              <stop offset="1" stop-color="#e5573a"></stop>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="logo-text">{company.name}</span>
    </a>

    <nav aria-label="Điều hướng chính" class="nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-hover>
                <span class="roll" data-text={l.label}>{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="#lien-he" class="btn btn-ghost cta" data-magnetic data-hover>
      Liên hệ <span class="arrow">↗</span>
    </a>

    <button class="menu-btn" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Menu di động" data-mobile-menu>
    <ul>
      {
        [...links, { href: "#lien-he", label: "Liên hệ" }].map((l, i) => (
          <li>
            <a href={l.href} data-menu-link>
              <small>0{i + 1}</small>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: transform 0.6s var(--ease), background 0.4s, backdrop-filter 0.4s;
  }
  .header.is-scrolled {
    background: rgb(7 8 11 / 0.6);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid var(--border);
  }
  .header.is-hidden {
    transform: translateY(-100%);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .logo-mark svg {
    width: 30px;
    height: 30px;
    display: block;
    transition: transform 0.8s var(--ease);
  }
  .logo:hover .logo-mark svg {
    transform: rotate(180deg);
  }
  .nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    font-size: 15px;
    color: var(--muted);
    transition: color 0.3s;
  }
  .nav a:hover {
    color: var(--text);
  }
  .roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }
  .roll::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--text);
  }
  .roll,
  .roll::after {
    transition: transform 0.5s var(--ease);
  }
  .nav a:hover .roll {
    transform: translateY(-100%);
  }
  .cta {
    padding: 11px 20px;
    font-size: 14px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    position: relative;
    cursor: pointer;
  }
  .menu-btn span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.4s var(--ease);
  }
  .menu-btn span:first-child { top: 18px; }
  .menu-btn span:last-child { top: 24px; }
  .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(3px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-3px) rotate(-45deg); }

  .mobile-menu {
    visibility: hidden;
    position: fixed;
    inset: 76px 0 0;
    background: var(--bg);
    padding: 32px clamp(16px, 4vw, 40px);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease), visibility 0s 0.7s;
    pointer-events: none;
  }
  .mobile-menu.is-open {
    visibility: visible;
    transition: clip-path 0.7s var(--ease);
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu small {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .nav,
    .cta {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>
